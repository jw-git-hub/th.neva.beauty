/** Задача 77, первая часть: ни в одной из 204 позиций прайса нет времени. */
function addDurationSection(form) {
  addSection(form, 'Сколько длится процедура',
    'В прайсе 204 позиции и ни у одной нет времени. Дальше — одна строка ' +
    'на процедуру, в каждой нужны минуты цифрой.');

  addQuestions(form, DURATION_HAIR, DURATION_HINT);
  addQuestions(form, DURATION_EPILATION, DURATION_HINT);
  addQuestions(form, DURATION_COSMETOLOGY, DURATION_HINT);
}

/** Задача 77, вторая часть: 169 позиций идут без единого слова пояснения. */
function addIncludedSection(form) {
