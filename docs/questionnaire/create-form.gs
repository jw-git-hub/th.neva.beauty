  addParagraph(form, 'Какими препаратами работаете?',
    'Названия и производитель. Если препараты оригинальные и это можно ' +
    'подтвердить — напишите, чем именно (сертификат, поставщик).');

  addChoice(form, 'Флакон вскрывают при клиенте?', YES_NO, '');

  addChoice(form, 'Осмотр до процедуры обязателен?', YES_NO, '');

  addParagraph(form, 'Что в перманентном макияже одноразовое?',
    'Иглы, модули, насадки, пигменты — перечислите, что меняется под каждого ' +
    'клиента.');

  addParagraph(form, 'Как обрабатывают многоразовый инструмент?',
    'Автоклав, сухожар, дезрастворы — что используете.');

  addChoice(form, 'Салон зарегистрирован в Таиланде?',
    ['Да, есть регистрация и лицензия', 'Да, регистрация есть, лицензии нет',
