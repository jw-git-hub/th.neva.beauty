    'Вопрос честно вынесен в FAQ на 11 страницах сайта — и ни в одном ответе ' +
    'нет срока. Дальше одна строка на процедуру: сколько дней нельзя. ' +
    'Если ограничений нет — 0.');

  addQuestions(form, SUN_SERVICES, AFTER_SUN_HINT);

  addSection(form, 'За сколько дней до процедуры нельзя загорать',
    'Лазер и аппараты реагируют на пигмент, поэтому свежий загар — причина ' +
    'перенести сеанс. Если загар не мешает — 0.');

  addQuestions(form, BEFORE_SUN_SERVICES, BEFORE_SUN_HINT);
}

/** Задача 80: число сеансов названо у пяти услуг, интервал — ни в одном ответе. */
function addCourseSection(form) {
  addSection(form, 'Интервал между сеансами курса',
    'Число сеансов на сайте названо у пяти услуг, а интервал между ними — ' +
    'ни разу. Дальше одна строка на процедуру: через сколько следующий сеанс.');

  addQuestions(form, COURSE_SERVICES, INTERVAL_HINT);

  addParagraph(form, 'Сколько сеансов в курсе — по каждой услуге',
    'Достаточно вилки: «лазер 6–8», «тату 5–10 в зависимости от пигмента».');
}

/** Задача 78: сайт не отвечает на «а что если». */
function addBookingSection(form) {
  addSection(form, 'Запись, отмена и предоплата',
    'Сайт не отвечает на «а что если»: можно ли перенести, нужна ли предоплата. ' +
    'Правила лучше назвать прямо — они защищают в первую очередь вас.');

  addChoiceWithOther(form, 'Нужна ли предоплата?',
    ['Нет', 'Да, на все процедуры', 'Только на курсы и дорогие процедуры',
     'Только для новых клиентов'], '');

  addText(form, 'Если предоплата нужна — сколько?',
    'Сумма или процент. Возвращается ли при отмене.');

  addChoiceWithOther(form,
    'За сколько можно отменить или перенести без последствий?',
    ['В любой момент', 'За 2 часа', 'За сутки', 'За 2 дня', 'Правила нет'], '');

  addParagraph(form, 'Что происходит, если клиент не пришёл или опоздал?',
    'Например: опоздание больше 15 минут — процедуру сокращают; неявка — ' +
    'предоплата не возвращается.');
}

function addFinalSection(form) {
  addSection(form, 'Напоследок', '');

  addParagraph(form, 'Что ещё стоит знать о салоне и не попало в вопросы?',
    'Всё, что клиенты спрашивают чаще всего, — сюда.');
}

/* ------------------------------------------------------------------ */
/* Обёртки над FormApp                                                 */
/* ------------------------------------------------------------------ */

/** Одинаковые короткие поля по списку названий — цифра в каждом. */
function addQuestions(form, titles, hint) {
  titles.forEach(function (title) {
    addText(form, title, hint);
  });
}

function addSection(form, title, description) {
  form.addPageBreakItem().setTitle(title).setHelpText(description);
}

function addText(form, title, help) {
  form.addTextItem().setTitle(title).setHelpText(help);
}

function addParagraph(form, title, help) {
  form.addParagraphTextItem().setTitle(title).setHelpText(help);
}

function addChoiceWithOther(form, title, choices, help) {
  form.addMultipleChoiceItem()
    .setTitle(title)
    .setHelpText(help)
    .setChoiceValues(choices)
    .showOtherOption(true);
}

function logFormUrls(form) {
  Logger.log('Ссылка для заполнения: %s', form.getPublishedUrl());
  Logger.log('Ссылка для правки: %s', form.getEditUrl());
}
