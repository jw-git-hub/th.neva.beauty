/* ------------------------------------------------------------------ */
/* Обёртки над FormApp                                                 */
/* ------------------------------------------------------------------ */

function addSection(form, title, description) {
  form.addPageBreakItem().setTitle(title).setHelpText(description);
}

function addText(form, title, help) {
  form.addTextItem().setTitle(title).setHelpText(help);
}

function addParagraph(form, title, help, isRequired) {
  form.addParagraphTextItem()
    .setTitle(title)
    .setHelpText(help)
    .setRequired(isRequired === true);
}

function addChoice(form, title, choices, help) {
  form.addMultipleChoiceItem()
    .setTitle(title)
    .setHelpText(help)
    .setChoiceValues(choices);
}

function addCheckbox(form, title, choices, help) {
  form.addCheckboxItem()
    .setTitle(title)
    .setHelpText(help)
    .setChoiceValues(choices);
}

function addGrid(form, title, help, rows, columns) {
  form.addGridItem()
    .setTitle(title)
    .setHelpText(help)
    .setRows(rows)
    .setColumns(columns);
}

function logFormUrls(form) {
  Logger.log('Ссылка для заполнения: %s', form.getPublishedUrl());
  Logger.log('Ссылка для правки: %s', form.getEditUrl());
}
