{% extends "base.html.j2" %}
{% from "partials/faq.html.j2" import faq_list %}
{% from "partials/booking.html.j2" import booking, cta_inline %}
{% from "partials/picture.html.j2" import responsive_img %}
{% block content %}
<section class="section container section--lead">
  <nav class="breadcrumbs breadcrumbs--lead" aria-label="Хлебные крошки">
    <a href="{{ base_path }}/">Главная</a>
    <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    <span aria-current="page">{{ cat.title }}</span>
  </nav>
  <div class="section-head" data-reveal>
    <p class="eyebrow">Направление</p><h1>{{ cat.h1 | default(cat.title, true) }}</h1><p>{{ cat.intro }}</p>
    {# Кнопка в шапке раздела: до неё первая точка записи на странице лежала
       на 5.5 экрана, а из поиска сюда приходят не реже, чем на услугу. #}
    <p class="section-head__action">
      <a class="btn btn--primary" href="{{ site.contacts.whatsapp_url }}?text={{ ('Здравствуйте! Хочу записаться на: ' ~ cat.title) | urlencode }}" target="_blank" rel="noopener">Записаться</a>
    </p>
  </div>
  <h2 class="visually-hidden">Услуги раздела «{{ cat.title }}»</h2>
  <div class="related-grid" data-reveal-children>
    {% for slug in cat.services %}{% set r = services.get(slug) %}{% if r %}
    <a class="related-card card" href="{{ base_path }}/{{ slug }}/">
      <div class="related-card__media">{{ responsive_img(card_image(r.hero_image), 'related_card', r.image_alt | default(r.title ~ ' — ' ~ cat.title ~ ', ' ~ site.brand_full, true)) }}</div>
      <div class="related-card__body">
        <h3>{{ r.title }}</h3>
        {% if price_from(slug) %}<span class="related-card__price">{{ price_from(slug) }}</span>{% endif %}
        <span class="related-card__more">Подробнее {{ icon('arrow-right') }}</span>
      </div>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>

{% if cat.compare %}
<section class="section container" id="sravnenie">
  <div class="section-head" data-reveal><p class="eyebrow">Сравнение</p><h2>{{ cat.compare.title }}</h2></div>
  <div class="compare" data-reveal>
    <table class="compare__table">
      <caption class="visually-hidden">{{ cat.compare.title }} — {{ cat.title }}, {{ site.brand_full }}</caption>
      <thead>
        <tr><th scope="col">Метод</th>{% for col in cat.compare.columns %}<th scope="col">{{ col }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in cat.compare.rows %}
        <tr>
          <th scope="row"><a href="{{ base_path }}/{{ row.slug }}/">{{ row.label }}</a></th>
          {% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {{ cta_inline(site, 'Не уверены, какой метод ваш? Опишите задачу — подскажем.', cat.title) }}
</section>
{% endif %}

{% if cat.faq %}
<section class="section container" id="faq">
  <div class="section-head" data-reveal><p class="eyebrow">Вопросы и ответы</p><h2>Частые вопросы — {{ cat.title }}</h2></div>
  {{ faq_list(cat.faq) }}
</section>
{% endif %}

{{ booking(site, cat.booking_title, 'Напишите, какая процедура раздела «' ~ cat.title ~ '» вам интересна, — подберём и метод, и время.', cat.title) }}

{# Переход в соседний раздел: со страницы услуги назад ведут и крошки,
   и «Смотрите также», а с раздела в соседний — только через меню в шапке. #}
{% set siblings = categories | rejectattr('slug', 'equalto', cat.slug) | list %}
{% if siblings %}
<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">Другие направления</p><h2>Что ещё делают в Neva Beauty кроме раздела «{{ cat.title }}»</h2></div>
  <nav class="cat-links" aria-label="Другие направления">
    {% for other in siblings %}
    <a class="cat-links__item" href="{{ base_path }}{{ other.url }}">{{ other.title }} {{ icon('arrow-right') }}</a>
    {% endfor %}
  </nav>
</section>
{% endif %}
{% endblock %}
