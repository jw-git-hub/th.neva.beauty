{#-
  Глобальный фоновый слой «Аврора»: мягкие размытые световые пятна под контентом.
  Подключается один раз в base. Пятна статичны; каждое получает через
  CSS-переменные позицию, размер, тон и плотность.
  Координаты — в % от вьюпорта (слой position:fixed). Тона — из токенов палитры.
-#}
{%- set blobs = [
  {'x':'12%','y':'8%', 'size':'48vw','tint':'var(--rose-soft)','op':'.62'},
  {'x':'78%','y':'2%', 'size':'42vw','tint':'#F1D3C5',         'op':'.66'},
  {'x':'62%','y':'52%','size':'54vw','tint':'var(--rose)',     'op':'.40'},
  {'x':'4%', 'y':'60%','size':'44vw','tint':'var(--taupe)',    'op':'.44'},
  {'x':'40%','y':'82%','size':'46vw','tint':'var(--rose-soft)','op':'.54'}
] -%}
<div class="aurora" aria-hidden="true">
{%- for b in blobs %}
  <span class="aurora__blob" style="--x:{{ b.x }};--y:{{ b.y }};--size:{{ b.size }};--tint:{{ b.tint }};--op:{{ b.op }}"></span>
{%- endfor %}
</div>
