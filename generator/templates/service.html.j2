{% extends "base.html.j2" %}
{% from "partials/faq.html.j2" import faq_list %}
{% from "partials/booking.html.j2" import booking, cta_inline %}
{% from "partials/picture.html.j2" import responsive_img %}
{% block content %}
<section class="svc-hero">
  <div class="container">
    <nav class="breadcrumbs breadcrumbs--lead" aria-label="Хлебные крошки">
      <a href="{{ base_path }}/">Главная</a>
      {% if category.is_page %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <a href="{{ base_path }}{{ category.url }}">{{ category.title }}</a>
      {% endif %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ svc.title }}</span>
    </nav>
    <div class="svc-hero__inner">
      <div class="svc-hero__text">
        <p class="eyebrow">{{ svc.category }}</p>
        <h1>{{ svc.h1 | default(svc.title, true) }}</h1>
        <p class="svc-hero__intro">{{ svc.intro }}</p>
        <a class="btn btn--primary" href="{{ site.contacts.whatsapp_url }}?text={{ ('Здравствуйте! Хочу записаться на: ' ~ svc.title) | urlencode }}" target="_blank" rel="noopener">Записаться</a>
      </div>
      <div class="svc-hero__media">
        <span class="svc-hero__blob" aria-hidden="true"></span>
        {{ responsive_img(svc.hero_image, 'service_hero', svc.image_alt | default(svc.title ~ ' — ' ~ site.brand_full, true), priority=True) }}
      </div>
    </div>
  </div>
</section>

{% if svc.benefits %}
<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">Преимущества</p><h2>{{ svc.benefits_title }}</h2></div>
  <div class="svc-benefits" data-reveal-children>
    {% for b in svc.benefits %}
    <div class="svc-benefit"><span class="svc-benefit__icon">{{ icon(b.icon) }}</span><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="section pricelist-section">
  <div class="container">
    {#- Заголовок блока вопросом, а под ним ответ первым же абзацем: «сколько
        стоит» — самый частый запрос аудитории, а блок начинался таблицей, и
        процитировать из него короткий ответ было нечего. Тот же вопрос стоял
        ещё и в FAQ: ответ перенесён сюда целиком, из FAQ вопрос убран — две
        одинаковые формулировки с двумя разными ответами не нужны ни клиенту,
        ни роботу. Суммы в ответе — плейсхолдерами из прайса. #}
    <div class="section-head" data-reveal><p class="eyebrow">Стоимость</p><h2>{{ svc.price_title }}</h2><p>{{ svc.price_lead | safe }}</p></div>
    {#- Полоска фактов: строка появляется только там, где салон назвал число.
        Порядок строк один на всех страницах, пустые молча выпадают. #}
    {%- set facts = [
          ('clock',    'Сколько длится',        svc.duration),
          ('check',    'Что входит в цену',     svc.included),
          ('sun',      'Солнце и море',         svc.sun),
          ('repeat',   'Интервал в курсе',      svc.course),
          ('sparkles', 'Когда виден результат', svc.effect),
        ] | selectattr('2') | list %}
    {%- if facts %}
    <dl class="svc-facts" data-reveal>
      {%- for fact_icon, term, value in facts %}
      <div class="svc-facts__row">
        <dt class="svc-facts__term">{{ icon(fact_icon) }}{{ term }}</dt>
        <dd class="svc-facts__value">{{ value }}</dd>
      </div>
      {%- endfor %}
    </dl>
    {%- endif %}
    <div class="pricelist" data-pricelist>
      {% set tabbed = sections|length > 1 %}
      {% if tabbed %}
      <div class="pricelist__tabs" role="tablist" aria-label="Разделы прайса — {{ svc.title }}">
        {% for sec in sections %}
        <button class="pricelist__tab{{ ' is-active' if loop.first }}" type="button" role="tab"
          id="tab-{{ slug }}-{{ loop.index0 }}" aria-controls="panel-{{ slug }}-{{ loop.index0 }}"
          tabindex="{{ '0' if loop.first else '-1' }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}" data-tab="{{ loop.index0 }}">{{ sec.section or 'Цены' }}<span class="pricelist__tab-count">{{ sec['items'] | length }}</span></button>
        {% endfor %}
      </div>
      {% endif %}
      {% for sec in sections %}
      <div class="pricelist__panel{{ ' is-active' if loop.first }}" data-panel="{{ loop.index0 }}"
        {%- if tabbed %} id="panel-{{ slug }}-{{ loop.index0 }}" role="tabpanel"
        aria-labelledby="tab-{{ slug }}-{{ loop.index0 }}" tabindex="0"{% endif %}>
        <table class="pricelist__table">
          <caption class="visually-hidden">{{ sec.section or 'Цены' }} — {{ svc.title }}, {{ site.brand_full }}</caption>
          <thead class="visually-hidden">
            <tr><th scope="col">Услуга</th><th scope="col">Цена</th></tr>
          </thead>
          <tbody>
            {% for it in sec['items'] %}
            <tr class="pricelist__row{{ ' is-promo' if it.promo }}">
              {# Пробелы между метками осмысленные: подписи блочные и на вид не влияют,
                 но именно они разделяют слова при копировании и чтении вслух. #}
              <th class="pricelist__name" scope="row">{% if it.promo %}<span class="pricelist__badge">Акция</span> {% endif %}{{ it.name }}{% if it.note %} <span class="pricelist__note">{{ it.note }}</span>{% endif %}{% if it.desc %} <span class="pricelist__desc">{{ it.desc }}</span>{% endif %}</th>
              <td class="pricelist__price">{{ it.price }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endfor %}
    </div>
    {{ cta_inline(site, 'Цена подошла? Напишите — забронируем время.', svc.title) }}
  </div>
</section>

{% if svc.faq %}
<section class="section container" id="faq">
  <div class="section-head" data-reveal><p class="eyebrow">Вопросы и ответы</p><h2>Частые вопросы — {{ svc.title }}</h2></div>
  {{ faq_list(svc.faq) }}
</section>
{% endif %}

{{ booking(site, svc.booking_title, 'Напишите — уточним, подходит ли вам «' ~ svc.title ~ '», и предложим свободное время.', svc.title) }}

{% if svc.related %}
<section class="section container">
  {# «Смотрите также» стояло заголовком на 17 страницах и не говорило ни клиенту,
     ни роботу, что именно внизу. Формула из названия услуги делает h2 своим. #}
  <div class="section-head" data-reveal><p class="eyebrow">Дополните уход</p><h2>Что выбирают вместе с услугой «{{ svc.title }}»</h2></div>
  <div class="related-grid" data-reveal-children>
    {% for rslug in svc.related %}{% set r = services.get(rslug) %}{% if r %}
    <a class="related-card card" href="{{ base_path }}/{{ rslug }}/">
      <div class="related-card__media">{{ responsive_img(card_image(r.hero_image), 'related_card', r.image_alt | default(r.title, true)) }}</div>
      <div class="related-card__body">
        <h3>{{ r.title }}</h3>
        {% if price_from(rslug) %}<span class="related-card__price">{{ price_from(rslug) }}</span>{% endif %}
        <span class="related-card__more">Подробнее {{ icon('arrow-right') }}</span>
      </div>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
{# Скрипт нужен только там, где вкладок больше одной: на 12 из 17 страниц с прайсом
   раздел единственный, и переключать нечего. #}
{% block extra_js %}{% if sections|length > 1 %}<script type="module" src="{{ asset('/assets/js/price-tabs.js') }}"></script>{% endif %}{% endblock %}
