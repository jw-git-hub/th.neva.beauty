{% extends "base.html.j2" %}
{% from "partials/faq.html.j2" import faq_list %}
{% from "partials/contact_strip.html.j2" import contact_strip %}
{% from "partials/booking.html.j2" import booking, cta_inline %}
{% from "partials/picture.html.j2" import responsive_img %}
{# Подтверждение прав в Search Console и Вебмастере. Только на главной:
   обе панели читают корень сайта, на остальных страницах тег бесполезен.
   Значения — в site.yml, там же причина, почему способ мета-тег, а не DNS. #}
{% block extra_head %}
{%- if site.verification.google %}
  <meta name="google-site-verification" content="{{ site.verification.google }}">
{%- endif %}
{%- if site.verification.yandex %}
  <meta name="yandex-verification" content="{{ site.verification.yandex }}">
{%- endif %}{% endblock %}
{% block content %}
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{{ home.hero_kicker | default(site.tagline) }}</p>
      <h1 class="hero__title">{% for line in home.hero_title_lines %}<span>{{ line }}</span>{{ " " }}{% endfor %}</h1>
      <p class="hero__sub">{{ home.hero_sub }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="{{ site.contacts.whatsapp_url }}?text={{ 'Здравствуйте! Хочу записаться' | urlencode }}" target="_blank" rel="noopener">Записаться</a>
        <a class="btn btn--ghost" href="#services">Услуги</a>
      </div>
    </div>
    <div class="hero__media">
      <span class="hero__blob" aria-hidden="true"></span>
      {{ responsive_img('hero', 'home_hero', home.hero_image_alt, cls='hero__photo', priority=True) }}
    </div>
  </div>
</section>

{{ contact_strip(site) }}

<section class="section container" id="services">
  <div class="section-head" data-reveal><p class="eyebrow">Услуги</p><h2>Направления красоты</h2><p>Аппаратные и уходовые процедуры под ваши задачи.</p></div>
  <div class="cat-grid" data-reveal-children>
    {% for c in categories %}
    <a class="cat-card card" href="{{ base_path }}{{ c.url }}">
      <div class="cat-card__media">{{ responsive_img(c.image, 'category_cover', c.image_alt | default(c.title, true)) }}</div>
      <div class="cat-card__body"><h3>{{ c.title }}</h3><span class="cat-card__more">Подробнее {{ icon('arrow-right') }}</span></div>
    </a>
    {% endfor %}
  </div>
  {{ cta_inline(site, 'Знаете, что хотите? Напишите — подберём время.', wide=true) }}
</section>

<section class="section benefits-section">
  <div class="container">
    <div class="section-head" data-reveal><p class="eyebrow">Почему {{ site.brand }}</p><h2>{{ home.benefits_title }}</h2></div>
    <div class="benefits-grid" data-reveal-children>
      {% for b in home.benefits %}
      <div class="benefit"><span class="benefit__icon">{{ icon(b.icon) }}</span><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">Популярное</p><h2>Частые процедуры</h2><p>Цены {{ site.business.currency_note | lower }}</p></div>
  <div class="popular-grid" data-reveal-children>
    {% for p in home.popular %}
    <a class="popular-card card" href="{{ base_path }}/{{ p.slug }}/">
      <span class="popular-card__info">
        <span class="popular-card__cat">{{ p.label }}</span>
        <span class="popular-card__name">{{ p.name }}</span>
      </span>
      <span class="popular-card__price">{{ item_price(p.slug, p.name) }}</span>
    </a>
    {% endfor %}
  </div>
  {{ cta_inline(site, 'Не нашли свою процедуру? Спросите — подскажем цену и время.', wide=true) }}
</section>

{#- Сводка цен по направлениям. «Сколько стоит» — самый частый запрос к салону,
    а на главной цены стояли только шестью карточками «Частое»: диапазона
    по направлению не было ни одного. Границы считаются из тех же прайсов,
    что уходят в AggregateOffer услуг, поэтому выдумать цену таблица не может. #}
<section class="section container" id="ceny">
  <div class="section-head" data-reveal><p class="eyebrow">Стоимость</p><h2>{{ home.price_title }}</h2><p>{{ home.price_lead | safe }}</p></div>
  <div class="compare" data-reveal>
    <table class="compare__table">
      <caption class="visually-hidden">Цены по направлениям — {{ site.brand_full }}</caption>
      <thead>
        {#- Цена второй колонкой, а не последней: перечисление услуг длинное и,
            стоя перед ценой, зажимает её в две строки. #}
        <tr><th scope="col">Направление</th><th scope="col">Цены</th><th scope="col">Что входит</th></tr>
      </thead>
      <tbody>
        {% for row in price_rows %}
        <tr>
          <th scope="row"><a href="{{ base_path }}{{ row.url }}">{{ row.label }}</a></th>
          <td class="compare__price">{{ row.span or '—' }}</td>
          <td>{{ row.services }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {{ cta_inline(site, 'Нашли свою процедуру? Напишите — назовём точную цену и время.', wide=true) }}
</section>

<section class="section container" id="faq">
  <div class="section-head" data-reveal>
    <p class="eyebrow">Вопросы и ответы</p>
    <h2>Коротко о {{ site.brand }}</h2>
    <p>{{ home.about_lead }}</p>
  </div>
  {{ faq_list(home.faq) }}
</section>

{{ booking(site, home.booking_title, 'Напишите, какая процедура интересует, — ответим в мессенджере, назовём цену и предложим свободное время.') }}
{% endblock %}
